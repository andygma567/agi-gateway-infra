# Local Docker Compose — headless init (committed as langfuse.env because .env is gitignored)
# Docs: https://langfuse.com/self-hosting/administration/headless-initialization
#
# UI:     http://langfuse.test
# Login:  local@langfuse.com / password
#
# SDK:
#   LANGFUSE_HOST=http://langfuse.test
#   LANGFUSE_PUBLIC_KEY=pk-lf-local-dev-public-key
#   LANGFUSE_SECRET_KEY=sk-lf-local-dev-secret-key
#
# Do not double-quote LANGFUSE_INIT_* values (Compose quirk).
#
# NEXTAUTH_URL must match the public URL behind nginx, or login redirects break.

NEXTAUTH_URL=http://langfuse.test

LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=Local Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev-secret-key
LANGFUSE_INIT_USER_EMAIL=local@langfuse.com
LANGFUSE_INIT_USER_NAME=Local Dev
LANGFUSE_INIT_USER_PASSWORD=password
